{
  "name": "@fin-health/shared",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "default": "./dist/types/index.js"
    },
    "./validators": {
      "types": "./src/validators/index.ts",
      "default": "./dist/validators/index.js"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./dist/errors.js"
    },
    "./format": {
      "types": "./src/format.ts",
      "default": "./dist/format.js"
    }
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "zod": "^3.24.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
