{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "App.tsx", "app/**/*.ts", "app/**/*.tsx", "app.json", "metro.config.js"],
  "exclude": ["src/__tests__/**", "src/__mocks__/**"]
}
